{
  "build": {
    "env": {
      "VERCEL_PREVIEW_COMMENTS_ENABLED": "0"
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</images/home/hero-video-poster-sm.jpg>; rel=preload; as=image; media=\"(max-width: 1023px)\", </images/home/hero-video-poster.jpg>; rel=preload; as=image; media=\"(min-width: 1024px)\""
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/Ivy-Presto-font-Family/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
